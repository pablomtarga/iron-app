# Copie para .env e ajuste. Nada aqui é obrigatório para testar em casa.

# Endereço(s) pelo qual você abre o app (com https). Obrigatório quando for pra internet.
# Passkey só funciona em https (ou em localhost).
ORIGINS=https://iron.seudominio.com

# Quem pode criar conta. false = só o primeiro cadastro (recomendado pra uso pessoal).
ALLOW_SIGNUP=false

# Dias que o aparelho fica logado
TOKEN_DAYS=90

# Porta no seu servidor e em quais endereços ela escuta.
# 127.0.0.1 = só a própria máquina (use com Caddy/Nginx na frente). 0.0.0.0 = rede toda.
PORT=8787
BIND=127.0.0.1

# Seu usuário no Linux (comandos: id -u e id -g), pra a pasta data ficar sua
PUID=1000
PGID=1000
